# Count newly appended error-level lines for every business service log.  mtail
# starts at the end of existing files, so deployment does not alert on history.
# File format: timestamp|-|logger|-|source|-|level|-|function|-|message.
counter center_cv_log_errors_total by service

# Only current files; extensionless logs are explicitly selected in Compose.
getfilename() =~ /\/(?P<service>[^\/.]+)(?:\.log)?$/ {
  /(?i)^(?:[^|]*\|-\|){3}(?:error|fatal|critical)\|-\|/ {
    center_cv_log_errors_total[$service]++
  }
}
